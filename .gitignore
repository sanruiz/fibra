# Ignorar todo
/*

# Excepto estos archivos/directorios
!.gitignore
!.github/
!.githooks/
!install-hooks.sh
!wp-content/
!AGENTS.md

# Dentro de wp-content, ignorar todo
wp-content/*

# Excepto themes
!wp-content/themes/

# Dentro de themes, ignorar todo
wp-content/themes/*

# Excepto soma
!wp-content/themes/soma/
!wp-content/themes/soma/**

# Ignorar archivos generados en soma
wp-content/themes/soma/vendor/
wp-content/themes/soma/node_modules/
wp-content/themes/soma/.phpunit.cache/
wp-content/themes/soma/coverage/
wp-content/themes/soma/package-lock.json
wp-content/themes/soma/error_log

# Local environment files (contain secrets)
wp-content/themes/soma/local.env
wp-content/themes/soma/.env
wp-content/themes/soma/.env.local
