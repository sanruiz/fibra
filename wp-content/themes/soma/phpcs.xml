<?xml version="1.0"?>
<ruleset name="Soma Theme Coding Standards">
    <description>WordPress Coding Standards for Soma Theme</description>

    <!-- What to scan -->
    <file>.</file>
    
    <!-- Exclude patterns -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/Mocks/*</exclude-pattern>
    <exclude-pattern>/acf-json/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>
    <exclude-pattern>/sass/*</exclude-pattern>
    <exclude-pattern>/js/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>

    <!-- How to scan -->
    <arg value="sp"/> <!-- Show sniff and progress -->
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <!-- Rules: Check PHP version compatibility -->
    <config name="testVersion" value="8.1-"/>

    <!-- Rules: WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- Allow short array syntax -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
        
        <!-- Allow modern PHP syntax -->
        <exclude name="WordPress.PHP.DisallowShortTernary"/>
        
        <!-- Allow nullable types and union types -->
        <exclude name="WordPress.PHP.DisallowAlternativePHPTags.MaybeASPOpenTagFound"/>
    </rule>

    <!-- Rules: WordPress Core -->
    <rule ref="WordPress-Core">
        <!-- Allow modern namespace and use statements -->
        <exclude name="PSR2.Namespaces.NamespaceDeclaration"/>
        <exclude name="PSR2.Classes.ClassDeclaration"/>
    </rule>

    <!-- Rules: WordPress Docs -->
    <rule ref="WordPress-Docs"/>

    <!-- Rules: WordPress Extra -->
    <rule ref="WordPress-Extra">
        <!-- Allow short array syntax -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- Enforce PSR-4 autoloading naming conventions -->
    <rule ref="PSR1.Classes.ClassDeclaration"/>
    
    <!-- Check for PHP cross-version compatibility -->
    <config name="minimum_supported_wp_version" value="6.2"/>

    <!-- Show details about violations -->
    <arg name="report" value="summary"/>
    <arg name="report" value="source"/>
</ruleset>
