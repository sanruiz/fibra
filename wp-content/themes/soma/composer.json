{
    "name": "fibrasoma/soma-theme",
    "type": "wordpress-theme",
    "description": "Modern WordPress theme with PSR-4 architecture, ACF flexible content, and Elementor integration",
    "keywords": [
        "wordpress",
        "theme",
        "psr-4",
        "acf",
        "elementor",
        "singleton",
        "loadable"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Fibrasoma",
            "homepage": "https://github.com/sanruiz/fibra"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "damian-elenbaas/elementor-stubs": "^3.31",
        "miguelcolmenares/cf7-stubs": "^6.1.3.1",
        "php-stubs/acf-pro-stubs": "^6.5",
        "php-stubs/wordpress-seo-stubs": "^20.5",
        "php-stubs/wordpress-stubs": "^6.9",
        "php-stubs/wordpress-tests-stubs": "^7.1",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.4",
        "yoast/phpunit-polyfills": "*"
    },
    "autoload": {
        "psr-4": {
            "Soma\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Soma\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "quality-check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ],
        "fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
