parameters:
    level: 6
    paths:
        - includes
    excludePaths:
        - vendor
        - node_modules
        - tests/Mocks
    ignoreErrors:
        # ACF functions (stubs don't provide function signatures)
        - '#Function get_field not found#'
        # Contact Form 7 classes (no official stubs available)
        - '#unknown class WPCF7#'
        - '#invalid type WPCF7#'
        - '#Method .* has invalid return type WPCF7#'
        # Action callbacks don't need return types
        - '#Action callback returns .* but should not return anything#'
        # Allow missing array value types
        -
            identifier: missingType.iterableValue
        # Allow missing generic types
        -
            identifier: missingType.generics
    treatPhpDocTypesAsCertain: false
