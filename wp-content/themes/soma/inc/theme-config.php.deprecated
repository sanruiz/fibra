<?php 
/**
 * Theme General Config
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit; // Exit if accessed directly.
}

/**
 * Add a custom version to the stylesheet to manage cache-busting
 *
 * This function modifies the URL of the `style.css` file to append a custom version string
 * as a query parameter. This is useful for cache-busting, as it forces the browser to
 * reload the file when the version is changed.
 *
 * @param string $src The original source URL of the stylesheet.
 * @return string Modified source URL with the custom version added.
 */
function add_custom_version_to_stylesheet( $src ) {
    // Define the custom version you want to append. You can manually change this or generate it dynamically.
    $version = '2.0.4';

    // Check if the stylesheet is 'style.css' to apply the versioning.
    if ( strpos( $src, 'style.css' ) ) {
        // Add the custom version as a query parameter 'ver' to the stylesheet URL.
        $src = add_query_arg( 'ver', $version, $src );
    }

    // Return the modified URL.
    return $src;
}

// Hook into the 'style_loader_src' filter to apply the custom version to the stylesheet URL.
add_filter( 'style_loader_src', 'add_custom_version_to_stylesheet', 10, 2 );

/**
 * Register Theme Scripts
 * https://developer.wordpress.org/reference/hooks/wp_enqueue_scripts/
 */
function ditto_scripts() {
    // CSS Variables - Load FIRST (highest priority)
    wp_enqueue_style( 'soma-variables', get_template_directory_uri() . '/assets/css/variables.css', array(), '3.0.0' );
    
    // Core styles
    wp_enqueue_style( 'core', get_template_directory_uri() . '/style.css', array( 'soma-variables' ) );
    wp_enqueue_style('main-styles', get_template_directory_uri() . '/css/main.bundle.css', array( 'soma-variables' ), '2.0.7');
    
    // Scripts
    wp_enqueue_script('main-scripts', get_template_directory_uri() . '/js/main.bundle.js', array('jquery'), '2.0.7', true);
}
add_action( 'wp_enqueue_scripts', 'ditto_scripts');

/**
 * Register Navigation Menus
 * https://developer.wordpress.org/reference/functions/register_nav_menus/
 */
function ditto_navigation_menus() {
    $locations = array(
        'main_menu'                     => __( 'Main Menu', 'text_domain' ),
        'social'                        => __( 'Social', 'text_domain' ),
        'business_units'                => __( 'Business Units', 'text_domain' ),
        'fibrasoma_footer'              => __( 'Fibrasoma Footer', 'text_domain' ),
        'navigation_sidebar_template'   => __( 'Navigation Sidebar Template', 'text_domain' )
    );
    register_nav_menus( $locations );
}
add_action( 'init', 'ditto_navigation_menus' );

/**
 * Register ACF Custom Menu
 * https://www.advancedcustomfields.com/resources/acf_add_options_page/
 */
function soma_menu_settings() {
    if (function_exists('acf_add_options_page')) {
        acf_add_options_page(array(
            'page_title'    => 'Theme Settings',
            'menu_title'    => 'Theme Settings',
            'menu_slug'     => 'theme-settings',
            'capability'    => 'edit_posts',
            'redirect'      =>  true
        ));
        
        acf_add_options_sub_page(array(
            'page_title' 	=> 'Header',
            'menu_title' 	=> 'Header',
            'parent_slug'   => 'theme-settings',
        ));

        acf_add_options_sub_page(array(
            'page_title' 	=> 'Footer',
            'menu_title' 	=> 'Footer',
            'parent_slug'   => 'theme-settings',
        ));
        
        acf_add_options_sub_page(array(
            'page_title' 	=> '404 Error',
            'menu_title' 	=> '404 Error',
            'parent_slug'   => 'theme-settings',
        ));
    }
}
add_action('init', 'soma_menu_settings');

