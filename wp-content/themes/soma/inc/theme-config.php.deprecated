/**
 * Translate Date
 */
function translateDate ($strDate, $format = null) {
    if(wpm_get_language() == 'es' && !$format) {
        $strDate = str_replace("January", "Enero", $strDate);
        $strDate = str_replace("February", "Febrero", $strDate);
        $strDate = str_replace("March", "Marzo", $strDate);
        $strDate = str_replace("April", "Abril", $strDate);
        $strDate = str_replace("May", "Mayo", $strDate);
        $strDate = str_replace("June", "Junio", $strDate);
        $strDate = str_replace("July", "Julio", $strDate);
        $strDate = str_replace("August", "Agosto", $strDate);
        $strDate = str_replace("September", "Septiembre", $strDate);
        $strDate = str_replace("October", "Octubre", $strDate);
        $strDate = str_replace("November", "Noviembre", $strDate);
        $strDate = str_replace("December", "Diciembre", $strDate);
    }

    if(wpm_get_language() == 'es' && $format == 'short') {
        $strDate = str_replace("Jan", "Ene", $strDate);
        $strDate = str_replace("Apr", "Abr", $strDate);
        $strDate = str_replace("Aug", "Ago", $strDate);
        $strDate = str_replace("Dec", "Dic", $strDate);
    }

    return $strDate;
}

