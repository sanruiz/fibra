// fetch stock data from Yahoo Finance API
function fetch_stock_data()
{
    $response = wp_remote_get('https://apidojo-yahoo-finance-v1.p.rapidapi.com/market/v2/get-quotes?region=US&symbols=SOMA21.MX', [
        'headers' => [
            'x-rapidapi-key' => 'fcea2b884fmshd2599170d0a0089p1d0897jsnd0b613f3fb0f',
            'x-rapidapi-host' => 'apidojo-yahoo-finance-v1.p.rapidapi.com'
        ]
    ]);

    if (is_wp_error($response)) {
        error_log('Failed to fetch stock data: ' . $response->get_error_message());
        return;
    }

    $body = json_decode(wp_remote_retrieve_body($response), true);
    if (!empty($body['quoteResponse']['result'][0])) {
        $data = $body['quoteResponse']['result'][0];

        // Estructura de los datos a almacenar
        $stock_data = [
            'price' => $data['regularMarketPrice'],
            'volume' => $data['regularMarketVolume'],
            'change' => $data['regularMarketChange'],
            'percent' => $data['regularMarketChangePercent'],
            'exchangeTimezoneName' => $data['exchangeTimezoneName'],
            'exchangeTimezoneOffset' => $data['gmtOffSetMilliseconds'],
            'symbol' => $data['symbol'],
            'timestamp' => $data['regularMarketTime'],
            'currency' => $data['currency'],
            'shortName' => $data['shortName'],
            'longName' => $data['longName'],
            'marketState' => $data['marketState']
        ];

        // Almacena los datos en la base de datos como opción
        update_option('stock_data', $stock_data);
    }
}

// Agregar un evento para ejecutar la función cada 3 horas
if (!wp_next_scheduled('update_stock_data_event')) {
    wp_schedule_event(time(), 'three_hours', 'update_stock_data_event');
}


add_action('update_stock_data_event', 'fetch_stock_data');

// Agregar el intervalo de 3 horas al cron de WordPress
function custom_cron_schedules($schedules)
{
    $schedules['three_hours'] = [
        'interval' => 3 * HOUR_IN_SECONDS,
        'display' => __('Every 3 Hours')
    ];
    return $schedules;
}
add_filter('cron_schedules', 'custom_cron_schedules');
