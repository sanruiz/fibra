# Local Environment Variables Example
# Copy this file to local.env and fill in your actual values
# DO NOT commit local.env - it's excluded in .gitignore

# ============================================================================
# Stock Data API Configuration
# ============================================================================
# Yahoo Finance API via RapidAPI
# Get your API key from: https://rapidapi.com/apidojo/api/yahoo-finance1
# 
# This key is required for running external-api tests locally.
# Tests will be skipped if the key is not provided.
#
# Usage:
#   1. Copy this file to local.env
#   2. Replace 'your-api-key-here' with your actual RapidAPI key
#   3. Run: source local.env && ./vendor/bin/phpunit --group external-api
#
SOMA_STOCK_API_KEY=your-api-key-here
