#!/bin/bash
#
# SOMA Theme - Pre-commit Git Hook
# Prevents direct commits to protected branches
#
# Protected branches:
#   - main: Production branch (only via PR from develop or hotfix/*)
#   - develop: Development branch (only via PR from feature/fix)
#
# Workflow enforcement:
#   All development must happen on feature/fix/hotfix/chore/refactor branches
#   and be merged via Pull Requests
#

# Get current branch name
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

# Define protected branches
PROTECTED_BRANCHES=(
    "main"
    "develop"
)

# Check if current branch is protected (exact match)
for protected in "${PROTECTED_BRANCHES[@]}"; do
    if [ "$BRANCH" = "$protected" ]; then
        echo ""
        echo "🚫 ════════════════════════════════════════════════════════════"
        echo "   COMMIT BLOCKED: Cannot commit directly to '$BRANCH'"
        echo "════════════════════════════════════════════════════════════"
        echo ""
        echo "❌ The '$BRANCH' branch is protected and requires Pull Requests."
        echo ""
        echo "📋 Correct workflow:"
        if [ "$BRANCH" = "main" ]; then
            echo "   1. Create feature branch from develop:"
            echo "      git checkout develop"
            echo "      git checkout -b feature/your-feature"
            echo ""
            echo "   2. Make changes and commit"
            echo ""
            echo "   3. Create PR to develop:"
            echo "      gh pr create --base develop --title 'feat: Your feature' | cat"
        else
            echo "   1. Create feature branch from develop:"
            echo "      git checkout develop"
            echo "      git checkout -b feature/your-feature"
            echo ""
            echo "   2. Make changes and commit"
            echo ""
            echo "   3. Create PR to develop:"
            echo "      gh pr create --base develop | cat"
        fi
        echo ""
        echo "════════════════════════════════════════════════════════════"
        echo ""
        exit 1
    fi
done

# Allow commits on all other branches (feature/*, fix/*, hotfix/*, release/*, etc.)
exit 0
