#!/bin/bash
#
# SOMA Theme - Pre-commit Git Hook
# Prevents direct commits to protected branches
#
# Protected branches:
#   - main: Production branch (only receives PRs from week-*)
#   - week-*: Sprint branches (only receive PRs from feature/fix)
#   - develop: Legacy branch (deprecated, kept for safety)
#
# Workflow enforcement:
#   All development must happen on feature/fix/hotfix/chore/refactor branches
#   and be merged via Pull Requests
#

# Get current branch name
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

# Define protected branches
# Note: week-* branches are validated separately with regex pattern below
PROTECTED_BRANCHES=(
    "main"
    "week-*"  # Sprint branches (week-1, week-2, etc.) - validated via regex
    "develop" # Legacy branch (deprecated, kept for safety)
)

# Check if current branch is protected (exact match)
for protected in "${PROTECTED_BRANCHES[@]}"; do
    # Skip pattern entries (handled separately below)
    if [[ "$protected" == *"*"* ]]; then
        continue
    fi
    
    if [ "$BRANCH" = "$protected" ]; then
        echo ""
        echo "🚫 ════════════════════════════════════════════════════════════"
        echo "   COMMIT BLOCKED: Cannot commit directly to '$BRANCH'"
        echo "════════════════════════════════════════════════════════════"
        echo ""
        echo "❌ The '$BRANCH' branch is protected and requires Pull Requests."
        echo ""
        echo "📋 Correct workflow:"
        if [ "$BRANCH" = "main" ]; then
            echo "   1. Create feature branch from week-N:"
            echo "      git checkout week-2"
            echo "      git checkout -b feature/your-feature"
            echo ""
            echo "   2. Make changes and commit"
            echo ""
            echo "   3. Create PR to week-N (NOT main):"
            echo "      gh pr create --base week-2 --title 'feat: Your feature' | cat"
            echo ""
            echo "   4. After sprint ends, week-N is merged to main via PR"
        else
            echo "   1. Create feature branch from week-N:"
            echo "      git checkout week-2"
            echo "      git checkout -b feature/your-feature"
            echo ""
            echo "   2. Make changes and commit"
            echo ""
            echo "   3. Create PR to week-N:"
            echo "      gh pr create --base week-2 | cat"
        fi
        echo ""
        echo "════════════════════════════════════════════════════════════"
        echo ""
        exit 1
    fi
done

# Check if current branch matches week-* pattern
if [[ "$BRANCH" =~ ^week-[0-9]+$ ]]; then
    echo ""
    echo "🚫 ════════════════════════════════════════════════════════════"
    echo "   COMMIT BLOCKED: Cannot commit directly to '$BRANCH'"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    echo "❌ Sprint branches are protected and require Pull Requests."
    echo ""
    echo "📋 Correct workflow:"
    echo "   1. Create feature branch from $BRANCH:"
    echo "      git checkout $BRANCH"
    echo "      git checkout -b feature/your-feature"
    echo ""
    echo "   2. Make changes and commit to your feature branch"
    echo ""
    echo "   3. Create PR to $BRANCH:"
    echo "      gh pr create --base $BRANCH --title 'feat: Your feature' | cat"
    echo ""
    echo "   4. After PR approval, merge via GitHub"
    echo ""
    echo "════════════════════════════════════════════════════════════"
    echo ""
    exit 1
fi

# Allow commits on all other branches (feature/*, fix/*, hotfix/*, etc.)
exit 0
